# Copy this file to .env.local for local overrides. All variables are optional.

# Where inquiry form notifications are sent. Defaults to mach10media.et@gmail.com.
# VITE_INQUIRY_NOTIFICATION_EMAIL=you@example.com

# reCAPTCHA v3 site key that activates Firebase App Check.
# Create it in the Firebase console under App Check > Apps > Web, then add the
# same key here. Until this is set, the app sends no App Check tokens and the
# Firestore rules must not require them.
# VITE_APP_CHECK_SITE_KEY=
